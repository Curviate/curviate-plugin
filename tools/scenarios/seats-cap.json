{
  "name": "add a seat at the spending cap: the cap read first, the refusal reported, no retry",
  "setup": "bash \"$KIT_DIR/setup/seats-cap.sh\"",
  "turns": [
    "Add one more seat to my Team.",
    "go"
  ],
  "allowed_tools": [
    "Skill",
    "Read",
    "Bash"
  ],
  "allow_before_go": [],
  "expect": {},

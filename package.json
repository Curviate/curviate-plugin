{
  "name": "curviate-plugin-tools",
  "private": true,
  "description": "Tooling for this repository. The plugin itself is plain markdown and needs no build.",
  "type": "module",
  "scripts": {
    "generate": "node tools/generate-command-tables.mjs",
    "check": "node tools/generate-command-tables.mjs --check && node tools/check-copy.mjs",
    "check:copy": "node tools/check-copy.mjs"
  },
  "devDependencies": {
    "@curviate/cli": "0.43.0"
  }
}
